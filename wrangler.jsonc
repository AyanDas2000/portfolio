{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-14",
  "routes": [
    // Serve the portfolio at the apex and www. Cloudflare manages the DNS records on deploy.
    { "pattern": "ayandas.dev", "custom_domain": true },
    { "pattern": "www.ayandas.dev", "custom_domain": true }
  ],
  "assets": {
    // One-page site with no client routes: unknown paths get a real 404, not a soft-404 copy of the homepage.
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
